rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // The owner profile must be created manually in the Firebase Console.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'worker';
      allow update, delete: if isOwner();
    }

    match /workers/{workerId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();

      match /records/{recordId} {
        // As requested, every signed-in owner/worker can view and edit every worker's production rows.
        allow read, create, update, delete: if signedIn();
      }
    }
  }
}